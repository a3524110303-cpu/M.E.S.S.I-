# Copia este archivo a web/.env. No copies .env del prototipo ni lo publiques.
# development: pruebas en red controlada. production: HTTPS obligatorio.
MESSI_WEB_ENV=development
MESSI_WEB_SECRET_KEY=CAMBIAR_CLAVE_ALEATORIA_DE_AL_MENOS_50_CARACTERES
MESSI_WEB_ALLOWED_HOSTS=localhost,127.0.0.1
MESSI_WEB_CSRF_TRUSTED_ORIGINS=
MESSI_WEB_DB_NAME=messi_web
MESSI_WEB_DB_USER=messi_web
MESSI_WEB_DB_PASSWORD=CAMBIAR_PASSWORD_MYSQL
MESSI_WEB_DB_HOST=127.0.0.1
MESSI_WEB_DB_PORT=3306
# Proveedores externos: certificado CA privado y verificación de identidad.
# MESSI_WEB_DB_SSL_CA=C:/ruta/ca.pem
# MESSI_WEB_DB_SSL_VERIFY=1

# Compose producción: dominio apuntado al servidor; NO usa localhost.
MESSI_WEB_DOMAIN=CAMBIAR_DOMINIO
MESSI_WEB_TLS_EMAIL=CAMBIAR_CORREO
MESSI_WEB_DB_ROOT_PASSWORD=CAMBIAR_PASSWORD_ROOT_MYSQL

# Sólo pruebas automatizadas/desarrollo deliberado; nunca producción.
# MESSI_WEB_TEST_SQLITE=1
# MESSI_WEB_SQLITE_PATH=.qa/messi-web.sqlite3
